PACIFICEO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pacificeo
PACIFICEO_SUPABASE_URL=https://your-project.supabase.co
PACIFICEO_SUPABASE_JWT_SECRET=replace-with-secret-manager-reference
PACIFICEO_STAC_API_URL=https://earth-search.aws.element84.com/v1
PACIFICEO_TITILER_URL=
PACIFICEO_TILE_SIGNING_SECRET=replace-with-secret-manager-reference
PACIFICEO_TILE_ALLOWED_HOSTS=your-project.supabase.co
PACIFICEO_TILE_TOKEN_MINUTES=5
# Local Docker only; pass these through your shell or a local secret store.
PACIFICEO_LOCAL_DB_PASSWORD=replace-locally
PACIFICEO_LOCAL_JWT_SECRET=replace-locally
PACIFICEO_LOCAL_TILE_SIGNING_SECRET=replace-locally
PACIFICEO_SCHEDULER_POLL_SECONDS=60
PACIFICEO_PRIMARY_GRACE_MINUTES=30
PACIFICEO_RUNNER_LEASE_MINUTES=120
PACIFICEO_DASHBOARD_ORIGIN=http://localhost:5173
PACIFICEO_PIPELINE_COMMAND=/run/secrets/pacificeo_pipeline_adapter
PACIFICEO_EMAIL_COMMAND=/run/secrets/pacificeo_email_adapter
PACIFICEO_IMESSAGE_COMMAND=/run/secrets/pacificeo_imessage_adapter
